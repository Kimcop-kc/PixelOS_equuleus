From dd63a1f2f5ab37c56a0606a384d59cca74af3468 Mon Sep 17 00:00:00 2001
From: sdm845 port <port@example.invalid>
Date: Wed, 12 Nov 2026 00:00:00 +0800
Subject: [PATCH] sdm845-common: drop overlays without a PixelOS target

overlay-lineage/lineage-sdk/ targets lineage-sdk (absent from the
PixelOS manifest) and overlay-lineage/packages/apps/Dialer/
targets the LineageOS Dialer fork, whereas PixelOS uses
platform/packages/apps/Dialer, whose callrecord resources do not
exist. Both would abort resource merging, so remove them and stop
adding the directory to DEVICE_PACKAGE_OVERLAYS.
---
diff --git a/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml b/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml
deleted file mode 100644
index 0ecfc4c..0000000
--- a/overlay-lineage/lineage-sdk/lineage/res/res/values/config.xml
+++ /dev/null
@@ -1,27 +0,0 @@
-<?xml version="1.0" encoding="utf-8"?>
-<!--
