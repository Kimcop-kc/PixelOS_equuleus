From 4604bed82962475725045f16b1c6215838378742 Mon Sep 17 00:00:00 2001
From: sdm845 port <port@example.invalid>
Date: Wed, 12 Nov 2026 00:00:00 +0800
Subject: [PATCH] sdm845-common: switch build policy to vendor/aosp

Replace the two LineageOS-only build inputs with the PixelOS
equivalents that exist in PixelOS fifteen:
  vendor/lineage/config/device_framework_matrix.xml
    -> vendor/aosp/config/device_framework_matrix.xml
  vendor/lineage/config/BoardConfigReservedSize.mk
    -> vendor/aosp/config/BoardConfigReservedSize.mk

The replaced framework matrix is NOT identical: PixelOS' copy is
older and lacks the AIDL vendor.lineage.livedisplay and
vendor.lineage.touch HAL declarations. That is recorded as a
blocker (KNOWN_BLOCKERS.md B-07) because it governs VINTF
compatibility checking, not the build itself.

The replaced reserved-size file is also weaker: it reserves no
space for system/system_ext/product. Recorded as B-06.
---
diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index a8502d8..ce78ca7 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -56,7 +56,7 @@ DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := \
     hardware/qcom-caf/common/vendor_framework_compatibility_matrix.xml \
     hardware/qcom-caf/common/vendor_framework_compatibility_matrix_legacy.xml \
     hardware/xiaomi/vintf/xiaomi_framework_compatibility_matrix.xml \
-    vendor/lineage/config/device_framework_matrix.xml
+    vendor/aosp/config/device_framework_matrix.xml
 DEVICE_MANIFEST_FILE := $(COMMON_PATH)/manifest.xml
 DEVICE_MATRIX_FILE := hardware/qcom-caf/common/compatibility_matrix.xml
 
@@ -93,7 +93,15 @@ BOARD_SUPER_PARTITION_GROUPS := qti_dynamic_partitions
 BOARD_QTI_DYNAMIC_PARTITIONS_PARTITION_LIST := odm product system system_ext vendor
 BOARD_QTI_DYNAMIC_PARTITIONS_SIZE := 5163188224 # (BOARD_SUPER_PARTITION_SIZE - 4194304) 4MiB overhead
 
-include vendor/lineage/config/BoardConfigReservedSize.mk
+# PixelOS equivalent of LineageOS' vendor/lineage/config/BoardConfigReservedSize.mk.
+#
+# WARNING (tracked as KNOWN_BLOCKERS.md B-06): the PixelOS file only sets
+# BOARD_PRODUCTIMAGE_MINIMAL_PARTITION_RESERVED_SIZE for virtual A/B. It
+# does NOT reserve the ~1.9 GiB for product / 90 MiB for system and
+# system_ext that the LineageOS file reserves. super is 5,167,382,528 B
+# (4.81 GiB) with a qti_dynamic_partitions group of 5,163,188,224 B, so
+# image growth has to be watched on every build.
+include vendor/aosp/config/BoardConfigReservedSize.mk
 
 TARGET_USERIMAGES_USE_EXT4 := true
 TARGET_USERIMAGES_USE_F2FS := true
diff --git a/sdm845.mk b/sdm845.mk
index 480b1bc..b8d18d2 100644
--- a/sdm845.mk
+++ b/sdm845.mk
@@ -17,9 +17,14 @@ $(call inherit-product, hardware/qcom-caf/common/common.mk)
 PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := true
 
 # Overlays
+# overlay-lineage/ held exactly two subtrees, neither of which has a target
+# package in PixelOS fifteen:
+#   lineage-sdk/...           lineage-sdk is not in the PixelOS manifest
+#   packages/apps/Dialer/...  PixelOS uses platform/packages/apps/Dialer,
+#                             which has no callrecord resources
+# Both subtrees are deleted by the next commit. Keep only overlay/ here.
 DEVICE_PACKAGE_OVERLAYS += \
-    $(LOCAL_PATH)/overlay \
-    $(LOCAL_PATH)/overlay-lineage
+    $(LOCAL_PATH)/overlay
 
 PRODUCT_ENFORCE_RRO_TARGETS := *
 
