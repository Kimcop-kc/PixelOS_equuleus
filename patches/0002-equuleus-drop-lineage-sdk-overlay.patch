From 4b40d431f5c3ff71de2221b42dc2d95a2586c591 Mon Sep 17 00:00:00 2001
From: equuleus port <port@example.invalid>
Date: Wed, 12 Nov 2026 00:00:00 +0800
Subject: [PATCH] equuleus: drop overlay subtree without a PixelOS target

equuleus/overlay-lineage/lineage-sdk/ overrides resources of
lineage-sdk, which PixelOS fifteen does not check out at all.
Keeping the directory only produces an unresolved overlay target
during resource merging, so remove it and document in device.mk
why the two surviving subtrees are kept.
---
diff --git a/device.mk b/device.mk
index 5389ff0..b40f1fe 100644
--- a/device.mk
+++ b/device.mk
@@ -16,6 +16,18 @@ TARGET_SCREEN_HEIGHT := 2248
 TARGET_SCREEN_WIDTH := 1080
 
 # Overlays
+# overlay-lineage/ holds three subtrees; only two have a target package that
+# exists in PixelOS fifteen:
+#   frameworks/base/packages/SystemUI/.../config.xml
+#       config_udfpsColor is declared by PixelOS in
+#       packages/SystemUI/res/values/custom_config.xml
+#       (PixelOS-AOSP/frameworks_base@fifteen, verified).
+#   packages/apps/Aperture/.../config.xml
+#       LineageOS Aperture is checked out at packages/apps/Aperture by the
+#       PixelOS manifest (verified).
+#   lineage-sdk/... would have no target package at all (lineage-sdk is not
+#       in the PixelOS manifest) and is removed by the next commit, because
+#       an overlay without a target package aborts resource merging.
 DEVICE_PACKAGE_OVERLAYS += \
     $(LOCAL_PATH)/overlay \
     $(LOCAL_PATH)/overlay-lineage
